<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <connectionStrings>
        <!-- LocalDB + Windows Authentication, không chứa mật khẩu -->
        <add name="CyberGameDB"
             connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=CyberGameDB;Integrated Security=True"
             providerName="System.Data.SqlClient" />
    </connectionStrings>
</configuration>
